{
  "name": "convex-better-auth",
  "version": "2.0.4",
  "description": "A Better Auth -> Convex Auth 2.0 migration bridge. New projects should use convex-auth directly.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git",
    "directory": "packages/better-auth"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "import": "./dist/convex.js",
      "default": "./dist/convex.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vp pack",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": ">=1.7.1 <1.8.0",
    "convex-auth-core": "workspace:*",
    "convex-better-auth-adapter": "workspace:*",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "convex": "^1.45.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "convex": "^1.25.0"
  }
}
