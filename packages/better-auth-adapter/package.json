{
  "name": "convex-better-auth-adapter",
  "version": "0.13.5",
  "description": "A Better Auth database adapter for Convex — a migration bridge for existing Better Auth projects. New apps should use convex-auth directly.",
  "homepage": "https://github.com/shlomokabareti/convex-better-auth-2.0/tree/main/packages/better-auth-adapter#readme",
  "bugs": {
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git",
    "directory": "packages/better-auth-adapter"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "next-js": [
        "./dist/nextjs/index.d.ts"
      ]
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./adapter": {
      "types": "./dist/component/adapter.d.ts",
      "default": "./dist/component/adapter.js"
    },
    "./auth-config": {
      "types": "./dist/auth-config.d.ts",
      "default": "./dist/auth-config.js"
    },
    "./client/plugins": {
      "types": "./dist/client/plugins/index.d.ts",
      "default": "./dist/client/plugins/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "default": "./dist/nextjs/index.js"
    },
    "./nextjs/client": {
      "types": "./dist/nextjs/client.d.ts",
      "default": "./dist/nextjs/client.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "default": "./dist/plugins/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react-start": {
      "types": "./dist/react-start/index.d.ts",
      "default": "./dist/react-start/index.js"
    },
    "./test": "./src/test.ts",
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.1.18",
    "@convex-dev/migrations": "^0.3.6",
    "common-tags": "^1.8.2",
    "convex-helpers": "^0.1.95",
    "jose": "^6.2.2",
    "remeda": "^2.32.0",
    "semver": "^7.7.3",
    "type-fest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/test-utils": "1.7.2",
    "@edge-runtime/vm": "5.0.0",
    "@tanstack/react-start": "1.167.65",
    "@types/common-tags": "1.8.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.8.0",
    "better-auth": "1.7.2",
    "convex": "^1.45.0",
    "convex-test": "0.0.56",
    "next": "16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.1 <1.8.0",
    "convex": "^1.25.0",
    "react": "^18.3.1 || ^19.0.0"
  }
}
