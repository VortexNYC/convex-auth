{
  "name": "convex-auth",
  "version": "1.7.0",
  "description": "Convex-native auth server, component, and integration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git",
    "directory": "packages/auth"
  },
  "bin": {
    "convex-auth": "./dist/scripts/cli.js"
  },
  "files": [
    "dist",
    "conformance",
    "test.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./convex": {
      "convex": "./src/convex-runtime/native/index.ts",
      "types": "./src/convex-runtime/native/index.ts",
      "import": "./dist/convex.js",
      "default": "./dist/convex.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "default": "./dist/mcp.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    },
    "./preflight": {
      "types": "./dist/preflight.d.ts",
      "import": "./dist/preflight.js",
      "default": "./dist/preflight.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.js",
      "default": "./dist/component.js"
    },
    "./conformance/*": "./conformance/*",
    "./consumer-contract": {
      "types": "./dist/consumer-contract.d.ts",
      "import": "./dist/consumer-contract.js",
      "default": "./dist/consumer-contract.js"
    },
    "./agent-auth-protocol": {
      "types": "./dist/agent-auth-protocol.d.ts",
      "import": "./dist/agent-auth-protocol.js",
      "default": "./dist/agent-auth-protocol.js"
    },
    "./agent-auth-protocol/convex": {
      "types": "./dist/agent-auth-protocol-convex.d.ts",
      "import": "./dist/agent-auth-protocol-convex.js",
      "default": "./dist/agent-auth-protocol-convex.js"
    },
    "./agent-auth-protocol/http": {
      "types": "./dist/agent-auth-protocol-http.d.ts",
      "import": "./dist/agent-auth-protocol-http.js",
      "default": "./dist/agent-auth-protocol-http.js"
    },
    "./auth-md": {
      "types": "./dist/auth-md.d.ts",
      "import": "./dist/auth-md.js",
      "default": "./dist/auth-md.js"
    },
    "./waitlist": {
      "types": "./dist/waitlist.d.ts",
      "import": "./dist/waitlist.js",
      "default": "./dist/waitlist.js"
    },
    "./test": {
      "types": "./test.ts",
      "default": "./test.ts"
    },
    "./convex/http": {
      "convex": "./src/convex-runtime/native/http.ts",
      "types": "./dist/convex.d.ts",
      "import": "./dist/convex.js",
      "default": "./dist/convex.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "convex": "./src/component/convex.config.ts",
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config/core": {
      "convex": "./src/component/core/convex.config.ts",
      "types": "./dist/component/core/convex.config.d.ts",
      "default": "./dist/component/core/convex.config.js"
    },
    "./_generated/component/core": {
      "types": "./dist/component/core/_generated/component.d.ts"
    },
    "./convex.config/organizations": {
      "convex": "./src/component/organizations/convex.config.ts",
      "types": "./dist/component/organizations/convex.config.d.ts",
      "default": "./dist/component/organizations/convex.config.js"
    },
    "./_generated/component/organizations": {
      "types": "./dist/component/organizations/_generated/component.d.ts"
    },
    "./convex.config/servicePrincipals": {
      "convex": "./src/component/servicePrincipals/convex.config.ts",
      "types": "./dist/component/servicePrincipals/convex.config.d.ts",
      "default": "./dist/component/servicePrincipals/convex.config.js"
    },
    "./_generated/component/servicePrincipals": {
      "types": "./dist/component/servicePrincipals/_generated/component.d.ts"
    },
    "./convex.config/apiKeys": {
      "convex": "./src/component/apiKeys/convex.config.ts",
      "types": "./dist/component/apiKeys/convex.config.d.ts",
      "default": "./dist/component/apiKeys/convex.config.js"
    },
    "./_generated/component/apiKeys": {
      "types": "./dist/component/apiKeys/_generated/component.d.ts"
    },
    "./convex.config/agentAuth": {
      "convex": "./src/component/agentAuth/convex.config.ts",
      "types": "./dist/component/agentAuth/convex.config.d.ts",
      "default": "./dist/component/agentAuth/convex.config.js"
    },
    "./_generated/component/agentAuth": {
      "types": "./dist/component/agentAuth/_generated/component.d.ts"
    },
    "./convex.config/authMd": {
      "convex": "./src/component/authMd/convex.config.ts",
      "types": "./dist/component/authMd/convex.config.d.ts",
      "default": "./dist/component/authMd/convex.config.js"
    },
    "./_generated/component/authMd": {
      "types": "./dist/component/authMd/_generated/component.d.ts"
    },
    "./convex.config/webhooks": {
      "convex": "./src/component/webhooks/convex.config.ts",
      "types": "./dist/component/webhooks/convex.config.d.ts",
      "default": "./dist/component/webhooks/convex.config.js"
    },
    "./_generated/component/webhooks": {
      "types": "./dist/component/webhooks/_generated/component.d.ts"
    },
    "./convex.config/mcpOauth": {
      "convex": "./src/component/mcpOauth/convex.config.ts",
      "types": "./dist/component/mcpOauth/convex.config.d.ts",
      "default": "./dist/component/mcpOauth/convex.config.js"
    },
    "./_generated/component/mcpOauth": {
      "types": "./dist/component/mcpOauth/_generated/component.d.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vp pack --filter lib && vp pack --filter scripts && tsc -p tsconfig.component.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "@noble/hashes": "^2.4.0",
    "convex-auth-core": "workspace:*",
    "convex-helpers": "^0.1.80",
    "cookie": "^2.0.1",
    "jose": "^6.2.2",
    "oauth4webapi": "^3.8.7",
    "otpauth": "^9.5.1",
    "set-cookie-parser": "^3.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex": "^1.45.0",
    "convex-auth-react": "workspace:*",
    "convex-auth-react-native": "workspace:*",
    "convex-test": "0.0.56",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "convex": ">=1.39.0",
    "convex-auth-react": "workspace:*",
    "convex-auth-react-native": "workspace:*",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "convex": {
      "optional": false
    },
    "convex-auth-react": {
      "optional": true
    },
    "convex-auth-react-native": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
