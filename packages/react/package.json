{
  "name": "convex-auth-react",
  "version": "1.4.1",
  "description": "Public React UI and hooks for convex-auth.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vp pack src/index.ts src/client.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "convex-auth-core": "workspace:*",
    "convex-auth-ui": "workspace:*",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "convex": "^1.45.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "convex": ">=1.39.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
