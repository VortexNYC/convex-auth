  },
  "scripts": {
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "lint": "vp lint",
    "lint:convex": "vp lint packages/*/src/convex-runtime packages/*/src/component examples/*/convex",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "fix": "vp lint --fix && vp fmt",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ci:publish": "pnpm changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@convex-dev/eslint-plugin": "4.0.0",
    "@types/node": "^26.4.0",
    "vite-plus": "0.2.4"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@10.25.0"
