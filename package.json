{
  "name": "convex-better-auth-2.0",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Convex-native full-stack auth packages.",
  "keywords": [
    "auth",
    "convex",
    "typescript"
  ],
  "homepage": "https://github.com/shlomokabareti/convex-better-auth-2.0",
