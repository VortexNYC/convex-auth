{
  "name": "convex-better-auth-2.0",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Convex-native full-stack auth packages.",
  "keywords": [
    "auth",
    "convex",
    "typescript"
  ],
  "homepage": "https://github.com/shlomokabareti/convex-better-auth-2.0",
  "bugs": {
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0/issues"
  },
  "license": "Apache-2.0",
  "author": "Shlomo Kabareti",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlomokabareti/convex-better-auth-2.0.git"
  },
  "scripts": {
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "lint": "vp lint",
    "lint:convex": "vp lint packages/*/src/convex-runtime packages/*/src/component examples/*/convex",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "fix": "vp lint --fix && vp fmt",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "ci:publish": "pnpm changeset publish",
    "scan:secrets": "secretlint . --no-gitignore --secretlintignore .secretlintignore",
    "knip": "knip",
    "entire:review": "entire review",
    "entire:investigate": "entire investigate",
    "entire:why": "entire why",
    "entire:blame": "entire blame",
    "entire:experts": "entire experts",
    "entire:tokens": "entire tokens",
    "entire:tokens:profile": "entire tokens profile"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@convex-dev/eslint-plugin": "4.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.4.0",
    "knip": "^6.35.0",
    "secretlint": "^13.0.5",
    "simple-git-hooks": "^2.14.0",
    "vite-plus": "0.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run scan:secrets"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@10.25.0"
}
