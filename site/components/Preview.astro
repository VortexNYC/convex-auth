---
// A Blume <Component> (Preview/Code tabs over a live example iframe) with an
// optional third tab: Props. `of` names a component in the generated props
// registry — the same registry <PropsTable> renders, so the tab can't drift.
//
//   <Preview path="sign-in-form" of="AuthSignInForm" />
//
// Components with no props entry render Preview/Code only. The tab panes
// share the frame's measured height via Blume's height-report listener
// (copied below), so the Props table scrolls inside the same box.
import data from "blume:data";
import { highlightCode } from "blume/markdown";
import { withBase } from "blume/components/islands/base-path.ts";
import { contentStrings } from "blume/components/content/content-strings.ts";
import { EXAMPLE_PANE_MIN_PX } from "blume/components/content/example-pane.ts";
import Tab from "blume/components/content/Tab.astro";
import Tabs from "blume/components/content/Tabs.astro";
import { CODE_PADDING_BLOCK_REM } from "blume/theme/code-block-padding.ts";
import { examples, examplesBase } from "blume:examples";
import PropsTable from "./PropsTable.astro";

interface Props {
  /** Example name under site/examples/, e.g. "convex-user-button". */
  path: string;
  /** Component export name, e.g. "ConvexApiKeyList" — adds a Props tab. */
  of?: string;
  /** Comma-separated prop subset for the Props tab (see PropsTable.rows). */
  rows?: string;
}

const { path, of, rows } = Astro.props;
const entry = examples[path];
const { content: strings } = contentStrings(data, Astro.currentLocale);

const previewSrc = entry
  ? withBase(
      `${examplesBase}/${path.split("/").map(encodeURIComponent).join("/")}`,
    )
  : undefined;

const codeHtml = entry
  ? await highlightCode(entry.code, entry.lang, {
      className: "blume-source",
      themes: data.config.codeThemes,
    })
  : undefined;

// Height estimate mirrors blume's Component.astro: line-count estimate as the
// SSR/no-JS height, then the frame's measured height replaces it on all panes.
const LINE_PX = 21;
const REM_PX = 16;
const PADDING_PX = 2 * CODE_PADDING_BLOCK_REM * REM_PX;
const ESTIMATE_MAX_PX = 400;
const lineCount = entry ? entry.code.replace(/\n+$/u, "").split("\n").length : 0;
const paneHeight = Math.min(
  ESTIMATE_MAX_PX,
  Math.max(EXAMPLE_PANE_MIN_PX, lineCount * LINE_PX + PADDING_PX),
);
const paneStyle = `height:${paneHeight}px`;
const paneClass =
  "max-h-lvh motion-safe:transition-[height] motion-safe:duration-200";
---

{
  entry ? (
    <Tabs hash={false} sync={false}>
      <Tab
        class={`overflow-hidden p-0! ${paneClass}`}
        style={paneStyle}
        title={strings.preview}
      >
        <iframe
          class="h-full w-full"
          data-blume-example-frame
          loading="eager"
          src={previewSrc}
          title={`${strings.preview}: ${path}`}
        />
      </Tab>
      <Tab
        class={`overflow-hidden ${paneClass}`}
        style={paneStyle}
        title={strings.code}
      >
        <Fragment set:html={codeHtml} />
      </Tab>
      {of && (
        <Tab
          class={`overflow-hidden ${paneClass}`}
          style={paneStyle}
          title="Props"
        >
          <div class="h-full overflow-auto px-4 py-3">
            <PropsTable of={of} rows={rows} />
          </div>
        </Tab>
      )}
    </Tabs>
  ) : (
    <div class="not-prose my-6 rounded-blume border border-border px-3 py-2 text-muted-foreground text-sm">
      No example found at <code class="font-mono">{path}</code>. Add it under{" "}
      <code class="font-mono">examples/</code> in your project.
    </div>
  )
}

<script>
  import { EXAMPLE_PANE_MIN_PX } from "blume/components/content/example-pane.ts";

  const HEIGHT_REPORT = "blume:example-height";
  const HEIGHT_REQUEST = "blume:example-height-request";

  const frames = () =>
    document.querySelectorAll<HTMLIFrameElement>(
      "iframe[data-blume-example-frame]",
    );

  window.addEventListener("message", (event) => {
    if (
      event.origin !== window.location.origin ||
      event.data?.type !== HEIGHT_REPORT ||
      !Number.isFinite(event.data.height)
    ) {
      return;
    }
    const frame = Array.from(frames()).find(
      (candidate) => candidate.contentWindow === event.source,
    );
    const tabs = frame?.closest("blume-tabs");
    if (!frame || !tabs) {
      return;
    }
    frame.dataset.blumeReportedHeight = String(event.data.height);
    const height = `${Math.max(EXAMPLE_PANE_MIN_PX, event.data.height)}px`;
    for (const panel of tabs.querySelectorAll<HTMLElement>(
      "[data-blume-tab-panel]",
    )) {
      panel.style.height = height;
    }
  });

  for (const frame of frames()) {
    frame.contentWindow?.postMessage(
      { type: HEIGHT_REQUEST },
      window.location.origin,
    );
  }
</script>

