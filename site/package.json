{
  "name": "site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-props-registry.mjs && blume dev",
    "build": "node scripts/generate-props-registry.mjs && blume build",
    "doctor": "blume doctor",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "deploy": "pnpm dlx @convex-dev/static-hosting deploy",
