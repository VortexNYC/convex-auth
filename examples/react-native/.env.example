EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Native passkeys (dev build required; not supported in Expo Go) ---
# App-side: the rpID the iOS associated-domain entitlement points at.
# Defaults to the EXPO_PUBLIC_CONVEX_SITE_URL host, which matches the
# .convex.site well-known routes in convex/http.ts.
# PASSKEY_RP_ID=your-deployment.convex.site
#
# Convex deployment env (set in the dashboard or `convex env set`):
# PASSKEY_RP_ID            — must match the entitlement above
# PASSKEY_ORIGINS          — comma-separated; site origin plus
#                            "android:apk-key-hash:<base64url-sha256-of-cert>"
# PASSKEY_IOS_APP_ID       — "TEAMID.nyc.vortex.convexauth.demo"
# PASSKEY_ANDROID_PACKAGE  — nyc.vortex.convexauth.demo
# PASSKEY_ANDROID_SHA256_CERT_FINGERPRINT — "AA:BB:CC:..." from keytool -list -v
