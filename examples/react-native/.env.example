# Client-side: URL of your Convex deployment (used by the React Native / Expo app)
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Server-side Convex environment variables (set via `npx convex env set` or the dashboard)
# Email sender address used for verification/reset emails
EMAIL_FROM_ADDRESS=auth@example.com

# OAuth provider credentials (fill in the ones you want to enable)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Optional: override the site origin used in email/reset links
# SITE_URL=https://your-demo.example.com
