{
  "name": "examples-oauth",
  "version": "0.0.25",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "check:contract": "convex-auth check --convex-dir ./convex",
    "preflight": "convex-auth preflight --repo-root . --convex-dir ./convex --test-env .env.local --skip-backend-setup"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "@vortex-api/convex-auth": "workspace:*",
    "convex": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.2"
  }
}
