# Convex deployment URL — created by `pnpm dlx convex dev` (or your dashboard)
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# OAuth providers (optional — set on the Convex deployment via `convex env set`)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Convex deployment env (set via `pnpm dlx convex env set`):
#   JWT_PRIVATE_KEY / JWKS      — required, generated by `convex dev` setup
#   SITE_URL                    — http://localhost:3000 for local dev
#   ALLOW_EMAIL_TOKEN_FALLBACK  — "true" returns email tokens in API responses
#                                 for local testing without a mail provider
