# Convex deployment URL (used by the Vite React app)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Generic OAuth / OIDC provider (optional)
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_ISSUER=https://your-oidc-provider.example.com
OAUTH_OIDC_DISCOVERY=true
OAUTH_OIDC_USE_ID_TOKEN=true
OAUTH_OIDC_SCOPES=openid,email,profile
VITE_OAUTH_OIDC_CLIENT_ID=$OAUTH_OIDC_CLIENT_ID
