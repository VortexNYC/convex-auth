# Convex deployment URL (used by the Vite React app)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Passkey Relying Party ID and origin (required for WebAuthn sign-in)
# For local dev, keep the defaults; for a deployed demo, set to your public origin.
VITE_PASSKEY_RP_ID=localhost
VITE_PASSKEY_ORIGIN=http://localhost:5174

# Generic OAuth / OIDC provider (optional)
OAUTH_OIDC_CLIENT_ID=
OAUTH_OIDC_CLIENT_SECRET=
OAUTH_OIDC_ISSUER=https://your-oidc-provider.example.com
OAUTH_OIDC_DISCOVERY=true
OAUTH_OIDC_USE_ID_TOKEN=true
OAUTH_OIDC_SCOPES=openid,email,profile
VITE_OAUTH_OIDC_CLIENT_ID=$OAUTH_OIDC_CLIENT_ID

# OIDC provider (serves as an OAuth 2.1 / OpenID Connect provider)
OAUTH_PROVIDER_CLIENT_ID=
OAUTH_PROVIDER_CLIENT_NAME=Demo OIDC Client
OAUTH_PROVIDER_REDIRECT_URIS=http://localhost:5173/oauth/callback
OAUTH_PROVIDER_SCOPES=openid,email,profile
OAUTH_PROVIDER_LOGIN_URL=http://localhost:5173/oauth/consent
